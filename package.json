{
  "name": "visionxixlabs-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:vercel-build && prisma generate && npm run typecheck:production && next build --webpack",
    "check:vercel-build": "node scripts/check-vercel-build.mjs",
    "db:migrate:deploy": "node scripts/migration-deploy-preflight.mjs && prisma migrate deploy",
    "postinstall": "prisma generate",
    "migrate:resolve": "npx prisma migrate resolve --applied 20260219120000_add_lead_model",
    "start": "next start",
    "lint": "eslint .",
    "test": "node scripts/run-vitest.mjs",
    "typecheck": "node scripts/run-native-typecheck.mjs --noEmit",
    "typecheck:production": "node scripts/run-native-typecheck.mjs --noEmit -p tsconfig.next.json",
    "test:compiler": "node --test scripts/tests/test_dependency_package_specs.cjs scripts/tests/native-typescript-checker.cjs"
  },
