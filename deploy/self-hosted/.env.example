# V19 self-hosted configuration. Copy to .env and fill in. Never commit .env.
# Database password for the bundled PostgreSQL (any long random string).
POSTGRES_PASSWORD=
# Public address people use to reach V19, for sign-in links (https in real use).
NEXTAUTH_URL=http://localhost:3000
# Long random secret for sessions, for example: openssl rand -base64 48
NEXTAUTH_SECRET=
# Secret that protects scheduled jobs (cron) endpoints: openssl rand -hex 32
CRON_SECRET=
# Optional: local AI through the bundled Ollama service (docker compose --profile local-ai up -d).
# OLLAMA_BASE_URL=http://127.0.0.1:11434
