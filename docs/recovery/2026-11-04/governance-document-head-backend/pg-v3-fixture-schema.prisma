generator client {
 provider = "prisma-client-js"
 output = "./generated"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
model DurableAgentWorkflow {
  id                 String   @id @default(cuid())
  organizationId     String
  workflowKind       String
  objective          String   @db.Text
  /// queued | running | paused_for_approval | paused_for_input | retrying | completed | failed | cancelled
  status             String   @default("queued")
  autonomyLevel      String
  currentStep        String?
  inputJson          Json
  stateJson          Json
  requestedByUserId  String
  approvalProposalId String?
  pauseReason        String?
  failureCode        String?
  attemptCount       Int      @default(0)
  maxAttempts        Int      @default(3)
  nextAttemptAt      DateTime?
  leaseOwner         String?
  leaseExpiresAt     DateTime?
  cancelRequestedAt  DateTime?
  cancelledAt        DateTime?
  completedAt        DateTime?
  version            Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  events DurableAgentWorkflowEvent[]

  @@index([organizationId, status, updatedAt])
  @@index([status, nextAttemptAt])
  @@index([leaseExpiresAt])
  @@index([approvalProposalId])
}
model DurableAgentWorkflowEvent {
  id             String   @id @default(cuid())
  workflowRunId  String
  organizationId String
  sequence       Int
  eventType      String
  actorKind      String
  actorId        String?
  detailJson     Json
  occurredAt     DateTime @default(now())

  workflowRun DurableAgentWorkflow @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@unique([workflowRunId, sequence])
  @@index([organizationId, occurredAt])
  @@index([workflowRunId, occurredAt])
}
model OrgMembership {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole   @default(read_only)
  providerScopes String[]  @default([]) // empty = all providers; ["aws","gcp"] = restricted
  invitedBy      String?
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}
enum OrgRole {
  owner
  admin
  operator
  security_reviewer
  finance_viewer
  read_only
}
