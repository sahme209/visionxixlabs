hover:text-white\",\"children\":\"Security\"}]}]]}]]}]\n31:[\"$\",\"div\",null,{\"className\":\"flex flex-col items-center justify-center gap-4 border-t border-white/[0.07] pt-7 text-xs text-zinc-400 sm:flex-row sm:justify-between\",\"children\":[[\"$\",\"p\",null,{\"children\":[\"© \",2026,\" Vision XIX Labs. All rights reserved.\"]}],[\"$\",\"p\",null,{\"children\":\"Production access is service-verified. Demonstrations are clearly labeled.\"}]]}]\n32:[\"$\",\"div\",null,{\"className\":\"text-sm text-zinc-300 leading-relaxed [\u0026_a]:text-white [\u0026_a]:underline [\u0026_a:hover]:text-orange-300 [\u0026_code]:font-mono [\u0026_code]:text-[12px] [\u0026_code]:bg-black/40 [\u0026_code]:border [\u0026_code]:border-white/[0.06] [\u0026_code]:rounded [\u0026_code]:px-1.5 [\u0026_code]:py-0.5\",\"children\":\"Desktop APIs resolve a bearer-token desktop session. GitHub tokens are tenant- and repository-scoped. AI requires both available credit and explicit workspace provider policy. Write permissions and approval requirements depend on the supported workflow. Review the action’s required capabilities and approval state before execution.\"}]\n33:[\"$\",\"section\",null,{\"id\":\"roles\",\"className\":\"mb-12 scroll-mt-24\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[10px] font-semibold text-orange-400 uppercase tracking-widest mb-2\",\"children\":\"01\"}],[\"$\",\"h2\",null,{\"className\":\"text-2xl md:text-3xl font-bold text-white tracking-[-0.04em] mb-5\",\"children\":\"Workspace roles\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4 text-zinc-300 leading-relaxed\",\"children\":[\"$\",\"p\",null,{\"children\":\"Workspace membership establishes the tenant boundary. Each supported action checks its required capability at the server; approval authority is distinct from permission to execute.\"}]}]]}]\n34:[\"$\",\"section\",null,{\"id\":\"github\",\"className\":\"mb-12 scroll-mt-24\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[10px] font-semibold text-orange-400 uppercase tracking-widest mb-2\",\"children\":\"02\"}],[\"$\",\"h2\",null,{\"className\":\"text-2xl md:text-3xl font-bold text-white tracking-[-0.04em] mb-5\",\"children\":\"GitHub repository scope\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4 text-zinc-300 leading-relaxed\",\"children\":[\"$\",\"p\",null,{\"children\":\"The GitHub App installation determines which repositories are available. For a repository action, the service mints a short-lived token scoped to the selected repository rather than reusing a broad user token.\"}]}]]}]\n35:[\"$\",\"section\",null,{\"id\":\"agent\",\"className\":\"mb-12 scroll-mt-24\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[10px] font-semibold text-orange-400 uppercase tracking-widest mb-2\",\"children\":\"03\"}],[\"$\",\"h2\",null,{\"className\":\"text-2xl md:text-3xl font-bold text-white tracking-[-0.04em] mb-5\",\"children\":\"Agent authority\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4 text-zinc-300 leading-relaxed\",\"children\":[\"$\",\"p\",null,{\"children\":\"The decision loop may execute registered low-risk reads. Medium- and high-risk tools create proposals. In the separate-execution preview, an authorized independent reviewer records the decision, then the original requester uses Execute when the action is supported and current checks pass. An approval record is not evidence that a provider action ran.\"}]}]]}]\n36:[\"$\",\"section\",null,{\"id\":\"aws\",\"className\":\"mb-12 scroll-mt-24\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[10px] font-semibold text-orange-400 uppercase tracking-widest mb-2\",\"children\":\"04\"}],[\"$\",\"h2\",null,{\"className\":\"text-2xl md:text-3xl font-bold text-white tracking-[-0.04em] mb-5\",\"children\":\"AWS ECS authority\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4 text-zinc-300 leading-relaxed\",\"children\":[\"$\",\"p\",null,{\"children\":\"Axiom dispatches the tenant workflow; GitHub Actions OIDC assumes the environment's configured AWS role. AWS permissions therefore remain constrained by both the GitHub trust subject and the role policy.\"}]}]]}]\n37:[\"$\",\"section\",null,{\"id\":\"trust\",\"className\":\"mb-12 scroll-mt-24\",\"children\":[\"$undefined\",[\"$\",\"h2\",null,{\"className\":\"text-2xl md:text-3xl font-bold text-white tracking-[-0.04em] mb-5\",\"children\":\"Trust questions\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4 text-zinc-300 leading-relaxed\",\"children\":[\"$\",\"div\",null,{\"className\":\"grid sm:grid-cols-2 gap-3 my-6\",\"children\":[[\"$\",\"div\",\"Does sign-in grant GitHub write?\",{\"className\":\"rounded-xl border border-white/[0.06] bg-white/[0.02] p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[10px] font-semibold text-emerald-400 uppercase tracking-widest mb-2 inline-flex items-center gap-1.5\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"strokeWidth\":1.5,\"stroke\":\"currentColor\",\"aria-hidden\":\"true\",\"data-slot\":\"icon\",\"ref\":\"$undefined\",\"aria-labelledby\":\"$undefined\",\"className\":\"h-3 w-3\",\"children\":[null,[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z\"}]]}],\"Does sign-in grant GitHub write?\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-zinc-300 leading-relaxed\",\"children\":\"No. GitHub installation, repository scope, role checks, and approval are separate.\"}]]}],[\"$\",\"div\",\"Can the model approve itself?\",{\"className\":\"rounded-xl border border-white/[0.06] bg-white/[0.02] p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[10px] font-semibold text-emerald-400 uppercase tracking-widest mb-2 inline-flex items-center gap-1.5\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"strokeWidth\":1.5,\"stroke\":\"currentColor\",\"aria-hidd