.186-.676.401-.959.221-.29.349-.634.349-1.003 0-1.036-1.007-1.875-2.25-1.875s-2.25.84-2.25 1.875c0 .369.128.713.349 1.003.215.283.401.604.401.959v0a.64.64 0 0 1-.657.643 48.39 48.39 0 0 1-4.163-.3c.186 1.613.293 3.25.315 4.907a.656.656 0 0 1-.658.663v0c-.355 0-.676-.186-.959-.401a1.647 1.647 0 0 0-1.003-.349c-1.036 0-1.875 1.007-1.875 2.25s.84 2.25 1.875 2.25c.369 0 .713-.128 1.003-.349.283-.215.604-.401.959-.401v0c.31 0 .555.26.532.57a48.039 48.039 0 0 1-.642 5.056c1.518.19 3.058.309 4.616.354a.64.64 0 0 0 .657-.643v0c0-.355-.186-.676-.401-.959a1.647 1.647 0 0 1-.349-1.003c0-1.035 1.008-1.875 2.25-1.875 1.243 0 2.25.84 2.25 1.875 0 .369-.128.713-.349 1.003-.215.283-.4.604-.4.959v0c0 .333.277.599.61.58a48.1 48.1 0 0 0 5.427-.63 48.05 48.05 0 0 0 .582-4.717.532.532 0 0 0-.533-.57v0c-.355 0-.676.186-.959.401-.29.221-.634.349-1.003.349-1.035 0-1.875-1.007-1.875-2.25s.84-2.25 1.875-2.25c.37 0 .713.128 1.003.349.283.215.604.401.96.401v0a.656.656 0 0 0 .658-.663 48.422 48.422 0 0 0-.37-5.36c-1.886.342-3.81.574-5.766.689a.578.578 0 0 1-.61-.58v0Z"></path></svg><span class="truncate">CI/CD connectors</span></a></li><li><a class="flex items-center gap-2.5 px-3 py-1.5 rounded-lg text-sm transition-colors text-zinc-400 hover:text-white hover:bg-white/[0.04] border border-transparent" href="/docs/releaseops/readiness"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="h-3.5 w-3.5 shrink-0 "><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"></path></svg><span class="truncate">Readiness scoring</span></a></li></ul></div><div><p class="px-3 mb-1.5 text-[10px] font-semibold text-zinc-500 uppercase tracking-widest">Desktop</p><ul class="space-y-0.5"><li><a class="flex items-center gap-2.5 px-3 py-1.5 rounded-lg text-sm transition-colors text-zinc-400 hover:text-white hover:bg-white/[0.04] border border-transparent" href="/docs/desktop-install"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="h-3.5 w-3.5 shrink-0 "><path stroke-linecap="round" stroke-linejoin="round" d="m6.75 7.5 3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0 0 21 18V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v12a2.25 2.25 0 0 0 2.25 2.25Z"></path></svg><span class="truncate">Install the desktop app</span></a></li><li><a class="flex items-center gap-2.5 px-3 py-1.5 rounded-lg text-sm transition-colors text-zinc-400 hover:text-white hover:bg-white/[0.04] border border-transparent" href="/docs/integration-setup"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="h-3.5 w-3.5 shrink-0 "><path stroke-linecap="round" stroke-linejoin="round" d="M14.25 6.087c0-.355.186-.676.401-.959.221-.29.349-.634.349-1.003 0-1.036-1.007-1.875-2.25-1.875s-2.25.84-2.25 1.875c0 .369.128.713.349 1.003.215.283.401.604.401.959v0a.64.64 0 0 1-.657.643 48.39 48.39 0 0 1-4.163-.3c.186 1.613.293 3.25.315 4.907a.656.656 0 0 1-.658.663v0c-.355 0-.676-.186-.959-.401a1.647 1.647 0 0 0-1.003-.349c-1.036 0-1.875 1.007-1.875 2.25s.84 2.25 1.875 2.25c.369 0 .713-.128 1.003-.349.283-.215.604-.401.959-.401v0c.31 0 .555.26.532.57a48.039 48.039 0 0 1-.642 5.056c1.518.19 3.058.309 4.616.354a.64.64 0 0 0 .657-.643v0c0-.355-.186-.676-.401-.959a1.647 1.647 0 0 1-.349-1.003c0-1.035 1.008-1.875 2.25-1.875 1.243 0 2.25.84 2.25 1.875 0 .369-.128.713-.349 1.003-.215.283-.4.604-.4.959v0c0 .333.277.599.61.58a48.1 48.1 0 0 0 5.427-.63 48.05 48.05 0 0 0 .582-4.717.532.532 0 0 0-.533-.57v0c-.355 0-.676.186-.959.401-.29.221-.634.349-1.003.349-1.035 0-1.875-1.007-1.875-2.25s.84-2.25 1.875-2.25c.37 0 .713.128 1.003.349.283.215.604.401.96.401v0a.656.656 0 0 0 .658-.663 48.422 48.422 0 0 0-.37-5.36c-1.886.342-3.81.574-5.766.689a.578.578 0 0 1-.61-.58v0Z"></path></svg><span class="truncate">Integration setup</span></a></li></ul></div><div><p class="px-3 mb-1.5 text-[10px] font-semibold text-zinc-500 uppercase tracking-widest">Trust &amp; security</p><ul class="space-y-0.5"><li><a class="flex items-center gap-2.5 px-3 py-1.5 rounded-lg text-sm transition-colors text-zinc-400 hover:text-white hover:bg-white/[0.04] border border-transparent" href="/docs/security-model"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="h-3.5 w-3.5 shrink-0 "><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"></path></svg><span class="truncate">Security model</span></a></li><li><a class="flex items-center gap-2.5 px-3 py-1.5 rounded-lg text-sm transition-colors bg-orange-500/10 text-orange-300 border border-orange-500/20" href="/docs/permissions-model"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="h-3.5 w-3.5 shrink-0 text-orange-400"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"></path></svg><span class="truncate">Permissions model</span></a></li></ul></div><div><p class="px-3 mb-1.5 text-[10px] font-semibold text-zinc-500 uppercase tracking-widest">Reference</p><ul class="space-y-0.5"><li><a class="flex items-center gap-2.5 px-3 py-1.5 rounded-lg text-sm transition-colors text-zinc-400 hover:text-white hover:bg-white/[0.04] border border-transparent" href="/docs/troubleshooting"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="h-3.5 w-3.5 shrink-0 "><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z"></path></svg><span class="truncate">Troubleshooting</span></a></li><li><a class="flex items-center gap-2.5 px-3 py-1.5 rounded-lg text-sm transition-colors text-zinc-400 hover:text-white hover:bg-white/[0.04] border border-transparent" href="/docs/faq"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="h-3.5 w-3.5 shrink-0 "><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z"></path></svg><span class="truncate">FAQ</span></a></li><li><a class="flex items-center gap-2.5 px-3 py-1.5 rounded-lg text-sm transition-colors text-zinc-400 hover:text-white hover:bg-white/[0.04] border border-transparent" href="/docs/glossary"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="h-3.5 w-3.5 shrink-0 "><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"></path></svg><span class="truncate">Glossary</span></a></li></ul></div></div></nav></div></aside><main class="min-w-0"><header class="relative mb-12"><div aria-hidden="true" class="pointer-events-none absolute -inset-x-8 -top-12 h-[260px] -z-10 overflow-hidden"><div class="absolute top-0 left-[10%] w-[420px] h-[260px] rounded-full bg-brand-coral/[0.05] blur-[120px] ambient-drift"></div><div class="absolute top-4 right-[10%] w-[360px] h-[220px] rounded-full bg-brand-orange/[0.06] blur-[110px] ambient-drift" style="animation-delay:-8s"></div></div><p class="mono-label mb-4 inline-flex items-center gap-3"><span class="text-brand-coral/90 tabular-nums">—</span><span class="h-px w-6 bg-gradient-to-r from-brand-coral/60 to-transparent"></span>Trust · Permissions</p><h1 class="font-display text-4xl md:text-5xl font-bold text-white leading-[1.04] mb-5">Each capability has its own authority<!-- --> <span class="relative inline-block">boundary.<span aria-hidden="true" class="absolute left-0 -bottom-0.5 h-[2px] w-full rounded-full bg-gradient-to-r from-brand-coral via-amber-400/70 to-transparent"></span></span></h1><p class="text-[16px] text-zinc-400 leading-relaxed max-w-3xl">Signing in, reading a repository, proposing a write, approving it, and deploying are separate permissions. Axiom does not treat one successful connection as authority for everything else.</p></header><div class="rounded-xl border border-blue-500/15 bg-blue-500/[0.04] p-4 my-5"><div class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="h-4 w-4 text-blue-400 mt-0.5 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z"></path></svg><div class="flex-1 min-w-0"><p class="text-[10px] font-semibold text-blue-400 uppercase tracking-wider mb-1">Preview workflow reference</p><div class="text-sm text-zinc-300 leading-relaxed [&amp;_a]:text-white [&amp;_a]:underline [&amp;_a:hover]:text-orange-300 [&amp;_code]:font-mono [&amp;_code]:text-[12px] [&amp;_code]:bg-black/40 [&amp;_code]:border [&amp;_code]:border-white/[0.06] [&amp;_code]:rounded [&amp;_code]:px-1.5 [&amp;_code]:py-0.5">Separate requester execution is a local preview and is not production-activated. Your installed version may not include an Execute control. Check the controls and release guidance for your installed version; approval status alone does not prove that an action ran.</div></div></div></div><div class="rounded-xl border border-emerald-500/15 bg-emerald-500/[0.04] p-4 my-5"><div class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="h-4 w-4 text-emerald-400 mt-0.5 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"></path></svg><div class="flex-1 min-w-0"><p class="text-[10px] font-semibold text-emerald-400 uppercase tracking-wider mb-1">Fail closed</p><div class="text-sm text-zinc-300 leading-relaxed [&amp;_a]:text-white [&amp;_a]:underline [&amp;_a:hover]:text-orange-300 [&amp;_code]:font-mono [&amp;_code]:text-[12px] [&amp;_code]:bg-black/40 [&amp;_code]:border [&amp;_code]:border-white/[0.06] [&amp;_code]:rounded [&amp;_code]:px-1.5 [&amp;_code]:py-0.5">Desktop APIs resolve a bearer-token desktop session. GitHub tokens are tenant- and repository-scoped. AI requires both available credit and explicit workspace provider policy. Write permissions and approval requirements depend on the supported workflow. Review the action’s required capabilities and approval state before execution.</div></div></div></div><section id="roles" class="mb-12 scroll-mt-24"><p class="text-[10px] font-semibold text-orange-400 uppercase tracking-widest mb-2">01</p><h2 class="text-2xl md:text-3xl font-bold text-white tracking-[-0.04em] mb-5">Workspace roles</h2><div class="space-y-4 text-zinc-300 leading-relaxed"><p>Workspace membership establishes the tenant boundary. Each supported action checks its required capability at the server; approval authority is distinct from permission to execute.</p></div></section><section id="github" class="mb-12 scroll-mt-24"><p class="text-[10px] font-semibold text-orange-400 uppercase tracking-widest mb-2">02</p><h2 class="text-2xl md:text-3xl font-bold text-white tracking-[-0.04em] mb-5">GitHub repository scope</h2><div class="space-y-4 text-zinc-300 leading-relaxed"><p>The GitHub App installation determines which repositories are available. For a repository action, the service mints a short-lived token scoped to the selected repository rather than reusing a broad user token.</p></div></section><section id="agent" class="mb-12 scroll-mt-24"><p class="text-[10px] font-semibold text-orange-400 uppercase tracking-widest mb-2">03</p><h2 class="text-2xl md:text-3xl font-bold text-white tracking-[-0.04em] mb-5">Agent authority</h2><div class="space-y-4 text-zinc-300 leading-relaxed"><p>The decision loop may execute registered low-risk reads. Medium- and high-risk tools create proposals. In the separate-execution preview, an authorized independent reviewer records the decision, then the original requester uses Execute when the action is supported and current checks pass. An approval record is not evidence that a provider action ran.</p></div></section><section id="aws" class="mb-12 scroll-mt-24"><p class="text-[10px] font-semibold text-orange-400 uppercase tracking-widest mb-2">04</p><h2 class="text-2xl md:text-3xl font-bold text-white tracking-[-0.04em] mb-5">AWS ECS authority</h2><div class="space-y-4 text-zinc-300 leading-relaxed"><p>Axiom dispatches the tenant workflow; GitHub Actions OIDC assumes the environment&#x27;s configured AWS role. AWS permissions therefore remain constrained by both the GitHub trust subject and the role policy.</p></div></section><section id="trust" class="mb-12 scroll-mt-24"><h2 class="text-2xl md:text-3xl font-bold text-white tracking-[-0.04em] mb-5">Trust questions</h2><div class="space-y-4 text-zinc-300 leading-relaxed"><div class="grid sm:grid-cols-2 gap-3 my-6"><div class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-4"><p class="text-[10px] font-semibold text-emerald-400 uppercase tracking-widest mb-2 inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="h-3 w-3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path></svg>Does sign-in grant GitHub write?</p><p class="text-sm text-zinc-300 leading-relaxed">No. GitHub installation, repository scope, role checks, and approval are separate.</p></div><div class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-4"><p class="text-[10px] font-semibold text-emerald-400 uppercase tracking-widest mb-2 inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="h-3 w-3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path></svg>Can the model approve itself?</p><p class="text-sm text-zinc-300 leading-relaxed">No. The model may recommend a decision; an authorized independent human reviewer must record approval.</p></div><div class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-4"><p class="text-[10px] font-semibold text-emerald-400 uppercase tracking-widest mb-2 inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="h-3 w-3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path></svg>Is AI on by default?</p><p class="text-sm text-zinc-300 leading-relaxed">No. Workspace provider policy is opt-in and fails closed.</p></div><div class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-4"><p class="text-[10px] font-semibold text-emerald-400 uppercase tracking-widest mb-2 inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="h-3 w-3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path></svg>Does Axiom store an AWS access key?</p><p class="text-sm text-zinc-300 leading-relaxed">Not for the released ECS path. The tenant workflow uses OIDC.</p></div><div class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-4"><p class="text-[10px] font-semibold text-emerald-400 uppercase tracking-widest mb-2 inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="h-3 w-3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path></svg>Can risk be lowered by context?</p><p class="text-sm text-zinc-300 leading-relaxed">No. Context can only escalate a tool&#x27;s baseline risk.</p></div><div class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-4"><p class="text-[10px] font-semibold text-emerald-400 uppercase tracking-widest mb-2 inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="h-3 w-3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path></svg>Are identity providers active after configuration?</p><p class="text-sm text-zinc-300 leading-relaxed">No. They remain pending until a real identity flow is implemented and verified.</p></div></div></div></section><nav aria-label="Documentation pagination" class="mt-16 pt-6 border-t border-white/[0.06] grid sm:grid-cols-2 gap-3"><a class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-4 hover:border-white/[0.12] hover:bg-white/[0.03] transition-all group" href="/docs/security-model"><p class="text-[10px] font-semibold text-zinc-500 uppercase tracking-widest mb-1 inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="h-3 w-3"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"></path></svg> Previous</p><p class="text-sm font-semibold text-white group-hover:text-orange-300 transition-colors">Security model</p></a><a class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-4 hover:border-white/[0.12] hover:bg-white/[0.03] transition-all group text-right sm:text-right" href="/docs/approval-workflow"><p class="text-[10px] font-semibold text-zinc-500 uppercase tracking-widest mb-1 inline-flex items-center gap-1.5 justify-end w-full">Next <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="h-3 w-3"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path></svg></p><p class="text-sm font-semibold text-white group-hover:text-orange-300 transition-colors">Approval workflow</p></a></nav><div class="mt-8 rounded-xl border border-white/[0.06] bg-white/[0.02] p-4 flex items-center justify-between flex-wrap gap-3"><div><p class="text-sm font-semibold text-white mb-0.5">Still blocked?</p><p class="text-xs text-zinc-500">Include the failed step and error. Never send a password, token, or cloud secret.</p></div><a class="inline-flex items-center gap-2 px-4 py-2 border border-white/[0.1] text-zinc-300 rounded-full text-xs font-semibold hover:bg-white/5 hover:border-white/20 transition-colors" href="/contact">Open support request<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="h-3.5 w-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path></svg></a></div><!--$--><!--/$--></main></div></div><footer class="site-footer border-t border-white/[0.07] bg-[#090a08] px-5 pb-8 sm:px-8 lg:px-10"><div class="mx-auto max-w-[1280px]"><section class="flex flex-col gap-8 border-b border-white/[0.07] py-12 md:flex-row md:items-end md:justify-between lg:py-16" aria-labelledby="footer-cta-heading"><div><p class="text-[10px] font-medium uppercase tracking-[0.22em] text-zinc-400">Axiom Agent</p><h2 id="footer-cta-heading" class="mt-4 max-w-3xl text-3xl font-medium leading-tight tracking-[-0.045em] text-zinc-100 sm:text-5xl">Engineering intent, under control.</h2></div><div class="flex flex-wrap gap-3"><a class="rounded-lg bg-zinc-100 px-5 py-3 text-sm font-semibold text-zinc-950 hover:bg-white" href="/product">Explore Axiom</a><a class="rounded-lg border border-orange-300/30 px-5 py-3 text-sm font-medium text-orange-200 transition hover:border-orange-300/60 hover:bg-orange-300/[0.06]" href="/support">Founding Supporters</a></div></section><div class="grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-[2fr_repeat(3,1fr)] lg:gap-10"><div><a class="inline-flex items-center gap-2.5 text-sm font-semibold text-zinc-100" href="/"><img alt="" loading="lazy" width="28" height="28" decoding="async" data-nimg="1" class="object-contain" style="color:transparent" srcSet="/_next/image?url=%2Fvision-xix-logo.png&amp;w=32&amp;q=75 1x, /_next/image?url=%2Fvision-xix-logo.png&amp;w=64&amp;q=75 2x" src="/_next/image?url=%2Fvision-xix-logo.png&amp;w=64&amp;q=75"/>Vision XIX Labs</a><p class="mt-5 max-w-sm text-sm leading-6 text-zinc-400">Axiom Agent brings AI assistance, human authorization, execution, and evidence into one governed engineering workflow.</p><p class="mt-2 max-w-sm text-sm leading-6 text-zinc-400">We also build iOS applications.</p></div><div><h3 class="text-xs text-zinc-400">Product</h3><ul class="mt-5 space-y-3"><li><a class="text-sm text-zinc-400 transition-colors hover:text-white" href="/product">Product</a></li><li><a class="text-sm text-zinc-400 transition-colors hover:text-white" href="/demo">Demo</a></li><li><a class="text-sm text-zinc-400 transition-colors hover:text-white" href="/docs">Docs</a></li><li><a class="text-sm text-zinc-400 transition-colors hover:text-white" href="/download">Download</a></li><li><a class="text-sm text-zinc-400 transition-colors hover:text-white" href="/integrations">Integrations</a></li><li><a class="text-sm text-zinc-400 transition-colors hover:text-white" href="/plans">Pricing</a></li><li><a class="text-sm text-zinc-400 transition-colors hover:text-white" href="/security">Security</a></li></ul></div><div><h3 class="text-xs text-zinc-400">Company</h3><ul class="mt-5 space-y-3"><li><a class="text-sm text-zinc-400 transition-colors hover:text-white" href="/axiom">About</a></li><li><a class="text-sm text-zinc-400 transition-colors hover:text-white" href="/support">Founding Supporters</a></li><li><a class="text-sm text-zinc-400 transition-colors hover:text-white" href="/account/help">Support (account required)</a></li><li><a class="text-sm text-zinc-400 transition-colors hover:text-white" href="/contact">Contact</a></li><li><a class="text-sm text-zinc-400 transition-colors hover:text-white" href="/status">Service status</a></li></ul></div><div><h3 class="text-xs text-zinc-400">Legal</h3><ul class="mt-5 space-y-3"><li><a class="text-sm text-zinc-400 transition-colors hover:text-white" href="/privacy">Privacy</a></li><li><a class="text-sm text-zinc-400 transition-colors hover:text-white" href="/terms">Terms</a></li><li><a class="text-sm text-zinc-400 transition-colors hover:text-white" href="/security">Security</a></li></ul></div></div><div class="flex flex-col items-center justify-center gap-4 border-t border-white/[0.07] pt-7 text-xs text-zinc-400 sm:flex-row sm:justify-between"><p>© <!-- -->2026<!-- --> Vision XIX Labs. All rights reserved.</p><p>Production access is service-verified. Demonstrations are clearly labeled.</p></div></div></footer></div></div><button aria-label="Open Axiom Assistant" class="fixed bottom-6 right-6 z-[9998] hidden min-h-11 items-center gap-2.5 rounded-full border border-white/[0.08] bg-[#171717]/90 px-3.5 py-2 text-zinc-200 shadow-[0_14px_40px_-20px_rgba(0,0,0,0.9)] backdrop-blur-xl transition-all hover:border-white/[0.16] hover:bg-[#1a1a1a] hover:text-white focus:outline-none focus:ring-2 focus:ring-brand-coral/50 md:flex"><div class="relative flex h-7 w-7 items-center justify-center rounded-full border border-white/[0.07] bg-white/[0.035]"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="h-3.5 w-3.5 text-zinc-300"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 0 1-.825-.242m9.345-8.334a2.126 2.126 0 0 0-.476-.095 48.64 48.64 0 0 0-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0 0 11.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155"></path></svg><span class="absolute -right-0.5 -top-0.5 h-1.5 w-1.5 rounded-full bg-emerald-300 ring-2 ring-[#171717]"></span></div><span class="pr-1 text-[12px] font-medium tracking-[-0.01em]">Ask Axiom</span></button><script src="/_next/static/chunks/webpack-69f14800859f0b85.js" id="_R_" async=""></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,"1:\"$Sreact.fragment\"\n2:\"static/chunks/98500-202fb27570ee6051.js\"\n3:\"static/chunks/37882-b9dc7f2fb9b2a293.js\"\n4:\"static/chunks/93197-59c54cbbe39d027f.js\"\n5:\"static/chunks/app/layout-61075ac6ab106ee6.js\"\n6:I[71813,[\"98500\",\"$2\",\"37882\",\"$3\",\"93197\",\"$4\",\"7177\",\"$5\"],\"Providers\"]\n7:\"AxiomPanelProvider\"\n8:I[64864,[\"98500\",\"$2\",\"37882\",\"$3\",\"93197\",\"$4\",\"7177\",\"$5\"],\"$7\"]\n9:I[26832,[\"98500\",\"$2\",\"37882\",\"$3\",\"93197\",\"$4\",\"7177\",\"$5\"],\"RouteAnnouncer\"]\na:I[55768,[\"98500\",\"$2\",\"37882\",\"$3\",\"93197\",\"$4\",\"7177\",\"$5\"],\"ScrollProgress\"]\nb:I[11133,[\"98500\",\"$2\",\"37882\",\"$3\",\"93197\",\"$4\",\"7177\",\"$5\"],\"CommandPalette\"]\nc:I[57121,[],\"\"]\nd:I[74581,[],\"\"]\ne:\"static/chunks/38437-ab43c492a711661a.js\"\nf:\"static/chunks/42191-801106830bf87512.js\"\n10:\"static/chunks/app/docs/layout-98c2941056c4c8f9.js\"\n11:I[42191,[\"98500\",\"$2\",\"38437\",\"$e\",\"42191\",\"$f\",\"4499\",\"$10\"],\"Navigation\"]\n24:I[27123,[],\"default\",1]\n:HL[\"/_next/static/css/532cba65621fdb11.css\",\"style\"]\n:HL[\"/_next/static/css/fd496917896bbbdc.css\",\"style\"]\n:HL[\"/fonts/e4af272ccee01ff0-s.p.woff2\",\"font\",{\"crossOrigin\":\"anonymous\",\"type\":