(now) - RESPONSE_VALID_AGE);\n        // TODO: cleanup the shape of this type so it doesn\'t require overwriting the IO fields.\n        for source in &mut snapshot.sources {\n            if let Some(io_stats) = self.io_stats_of(&source.source_info) {\n                source.requests = io_stats.requests;\n                source.responses = io_stats.responses;\n                source.status = match (clock, oldest_response) {\n                    (Some(clock), Some(oldest_response)) => {\n                        io_stats.status(oldest_response, |tsc| clock.time_at(tsc))\n                    }\n                    _ => SourceStatus::Unknown,\n                };\n            }\n        }\n        snapshot\n    }\n\n    /// The request and response counters of the IO task serving a source, if it has one.\n    fn io_stats_of(&self, source_info: &SourceInfo) -> Option<IOStatsSnapshot> {\n        match source_info {\n            SourceInfo::AmazonTimeSync(..) => self.io_front_end.amazon_time_sync_io_stats(),\n            SourceInfo::NtpSource(address) => self.io_front_end.ntp_io_stats(address),\n            SourceInfo::Phc(_) => self.io_front_end.phc_io_stats(),\n        }\n    }\n\n    fn handle_event(&mut self, routable_event: RoutableEvent) {\n        if let Some(source_params) = self.clock_sync_algorithm.feed(routable_event) {\n            use crate::daemon::async_ring_buffer::SendError;\n\n            match self.clock_state_handle.tx.send(source_params.clone()) {\n                Ok(()) => (),\n                Err(SendError::Disrupted(source_params)) => {\n                    // don\'t handle_disruption. It will be handled on the next call of tokio::select\n                    debug!(\n                        ?source_params,\n                        "Trying to send a value when there was a disruption event. Dropping."\n                    );\n                }\n                Err(SendError::BufferClosed(e)) => {\n                    error!(\n                        ?e