{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axiom:support-retrieval-evaluation:v1",
  "title": "Proposed offline retrieval evaluation fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "articleId", "revision", "productVersion", "articleSha256", "status", "scope", "cases"],
  "properties": {
    "schema": {"const": 1},
    "articleId": {"type": "string", "pattern": "^axiom\\.help\\.[a-z0-9._-]+$"},
    "revision": {"type": "integer", "minimum": 1},
    "productVersion": {"type": "string", "minLength": 1},
    "articleSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"const": "proposed-not-executed"},
    "scope": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "question", "requiredResponse", "requiredCitation"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "requiredResponse": {"type": "string", "minLength": 1},
          "requiredCitation": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
