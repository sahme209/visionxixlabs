{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axiom:support-article:v1",
  "title": "Versioned Axiom support knowledge record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "revision",
    "status",
    "classification",
    "title",
    "productVersion",
    "screenIds",
    "controlIds",
    "goal",
    "prerequisites",
    "permissions",
    "steps",
    "expectedOutcome",
    "limitations",
    "recovery",
    "searchTerms",
    "sources",
    "media",
    "verification",
    "review",
    "supersedes"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^axiom\\.help\\.[a-z0-9._-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "superseded",
        "withdrawn"
      ]
    },
    "classification": {
      "enum": [
        "public",
        "internal"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "productVersion": {
      "type": "string",
      "minLength": 1
    },
    "screenIds": {
      "$ref": "#/$defs/strings"
    },
    "controlIds": {
      "$ref": "#/$defs/strings"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "prerequisites": {
      "$ref": "#/$defs/strings"
    },
    "permissions": {
      "$ref": "#/$defs/strings"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instruction",
          "effect",
          "expectedState"
        ],
        "properties": {
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "effect": {
            "enum": [
              "read",
              "local-preference",
              "propose",
              "human-review",
              "execute",
              "recover"
            ]
          },
          "expectedState": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "expectedOutcome": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "$ref": "#/$defs/strings"
    },
    "recovery": {
      "$ref": "#/$defs/strings"
    },
    "searchTerms": {
      "$ref": "#/$defs/strings"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path",
          "sha256",
          "description",
          "transcriptPath",
          "publicReviewApproved"
        ],
        "properties": {
          "kind": {
            "enum": [
              "screenshot",
              "video"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "transcriptPath": {
            "type": [
              "string",
              "null"
            ]
          },
          "publicReviewApproved": {
            "type": "boolean"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "evidencePaths",
        "verifiedVersion",
        "verifiedAt"
      ],
      "properties": {
        "kind": {
          "enum": [
            "unverified",
            "source-only",
            "simulated",
            "local-native",
            "live"
          ]
        },
        "evidencePaths": {
          "$ref": "#/$defs/strings"
        },
        "verifiedVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "verifiedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "reviewedAt"
      ],
      "properties": {
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "verification": {
            "properties": {
              "kind": {
                "enum": [
                  "source-only",
                  "simulated",
                  "local-native",
                  "live"
                ]
              },
              "verifiedVersion": {
                "type": "string",
                "minLength": 1
              },
              "verifiedAt": {
                "type": "string",
                "format": "date-time"
              },
              "evidencePaths": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
