    },
    {
      "path": "/api/cron/connector-health-scan",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/alert-escalation-tick",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/linkedin-daily-drafts",
      "schedule": "0 9 * * 1-5"
    },
    {
      "path": "/api/cron/linkedin-publish",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/releaseops-autonomous-tick",
      "schedule": "0 * * * *"
    }
  ]
