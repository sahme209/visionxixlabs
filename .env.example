# Copy to .env.local and fill in your values.

# Database (PostgreSQL required for Vercel)
# Use Vercel Postgres, Neon, Supabase, or any Postgres provider
# DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"
# Get your API key from https://resend.com/api-keys

RESEND_API_KEY=re_your_api_key_here

# AI provider — at least one required. Provider order: AI_PROVIDER or OpenAI → Gemini → Anthropic.
# OpenAI: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-your_openai_key_here
# Gemini: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_key_here
# Anthropic: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
# Preferred provider (optional): openai | gemini | anthropic
# AI_PROVIDER=openai
# Model overrides (optional)
# MODEL_NAME=gpt-4o
# OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-2.0-flash
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
CONTACT_EMAIL=support@visionxixlabs.com
RESEND_FROM_EMAIL=onboarding@resend.dev

# Auth (generate with: openssl rand -base64 32)
# NEXTAUTH_SECRET=your_secret_here
# NEXTAUTH_URL=http://localhost:3000

# Stripe Payment Links — create at https://dashboard.stripe.com/payment-links
# Per-plan (takes precedence):
# NEXT_PUBLIC_STRIPE_STARTER_MONTHLY=https://buy.stripe.com/xxx
# NEXT_PUBLIC_STRIPE_STARTER_YEARLY=https://buy.stripe.com/xxx
# NEXT_PUBLIC_STRIPE_GROWTH_MONTHLY=https://buy.stripe.com/xxx
# NEXT_PUBLIC_STRIPE_GROWTH_YEARLY=https://buy.stripe.com/xxx
# NEXT_PUBLIC_STRIPE_SCALE_MONTHLY=https://buy.stripe.com/xxx
# NEXT_PUBLIC_STRIPE_SCALE_YEARLY=https://buy.stripe.com/xxx
# Fallback: single link for all plans if per-plan not set
# NEXT_PUBLIC_STRIPE_CHECKOUT_LINK=https://buy.stripe.com/xxx

# Stripe Webhook — to set User.plan when customer pays
# Create webhook at https://dashboard.stripe.com/webhooks → Add endpoint → /api/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price IDs (from your Payment Links) — comma-separated per plan
# STRIPE_PRICES_STARTER=price_xxx,price_yyy
# STRIPE_PRICES_GROWTH=price_aaa,price_bbb
# STRIPE_PRICES_SCALE=price_ccc,price_ddd
# STRIPE_PRICES_ENTERPRISE=price_eee

# Optional: secret to view internal pricing at /internal/pricing?key=YOUR_SECRET
# INTERNAL_PRICING_KEY=your_secret_string

# AI Website Build — New Website Request flow
# Generate signed tokens for preview/thank-you links (required)
# STARTER_TOKEN_SECRET=your_hmac_secret_32_chars_min

# AI for starter package, chat, strategic brief, cloud operator (uses above keys)

# Vercel Deployments API for preview/production deploy
# VERCEL_TOKEN=vercel_api_token
# VERCEL_TEAM_ID=team_xxx (optional, for team projects)

# Base URL for emails and links
# NEXT_PUBLIC_BASE_URL=https://visionxixlabs.com

# AWS Connector (Axiom) — assume-role validation
# Enable: ENABLE_CLOUD_CONNECTORS_AWS=true
# Broker credentials (Vision XIX service account; used to assume into customer roles):
# AWS_CONNECTOR_BROKER_ACCESS_KEY_ID=AKIA...
# AWS_CONNECTOR_BROKER_SECRET_ACCESS_KEY=...
# AWS_CONNECTOR_BROKER_REGION=us-east-1
# Or use standard: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION

# Contact Resolution Agent — worker endpoint /api/agents/run
# CRON_SECRET=your_cron_secret (Authorization: Bearer CRON_SECRET)
# CONTACT_AGENT_USER_ID=system-contact-agent (userId for plugin execution when lead has no user)

# ============================================================================
# Canonical config — read by lib/config/env.ts
# ============================================================================

# Public app URL — used for absolute links and OAuth callbacks.
# APP_URL=https://visionxixlabs.com

# AWS scan mode — drives the cloud scan pipeline branch.
# Values: live | preview | disabled. Default: live when broker creds present, preview otherwise.
# AWS_SCAN_MODE=preview

# Azure live mode — Service Principal credentials.
# All four must be set for live mode. Reader role on the subscription is enough.
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=
# AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
# AZURE_SCAN_MODE=preview            # live | preview | disabled

# GCP live mode — Service Account credentials.
# Provide *either* the split form (CLIENT_EMAIL + PRIVATE_KEY) *or* the full JSON.
# GCP_PROJECT_ID=my-project-123456
# GCP_CLIENT_EMAIL=axiom-reader@my-project-123456.iam.gserviceaccount.com
# GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GCP_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...",...}'
# GCP_SCAN_MODE=preview              # live | preview | disabled

# GitHub sync mode — values: live | preview | disabled.
# Live requires GITHUB_PAT (or GITHUB_APP_ID + GITHUB_PRIVATE_KEY).
# GITHUB_SYNC_MODE=preview

# GitHub Personal Access Token — practical live path. Read-only fine-grained
# scopes recommended: contents:read, metadata:read, actions:read,
# administration:read (for branch protection).
# GITHUB_PAT=ghp_********

# GitHub App credentials — production path. Replaces PAT when configured.
# GITHUB_APP_ID=123456
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_INSTALLATION_ID=12345678
# GITHUB_WEBHOOK_SECRET=                # ≥ 32 chars when webhooks are configured

# Default org / user to scan in ReleaseOps when no org is supplied.
# GITHUB_DEFAULT_ORG=axiom-platform

# OAuth providers (already in use above). Setting these activates the
# Google / GitHub buttons on /auth/signin. NOT used for live data reads.
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GITHUB_CLIENT_ID=...
# GITHUB_CLIENT_SECRET=...

# Desktop runtime
# DESKTOP_MODE=preview                # preview | live | disabled
# DESKTOP_DOWNLOADS_ENABLED=false     # set true only when signed binaries are served
# DESKTOP_HANDOFF_SIGNING_KEY=        # ≥ 32 chars; falls back to NEXTAUTH_SECRET if unset

# Audit signing key (optional — falls back to NEXTAUTH_SECRET when unset)
# AUDIT_SIGNING_KEY=

# Optional log level — debug | info | warn | error | critical (default: info in prod)
# LOG_LEVEL=info
