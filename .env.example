# Copy to .env.local and fill in your values.

# Database (PostgreSQL required for Vercel)
# Use Vercel Postgres, Neon, Supabase, or any Postgres provider
# DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"
# Get your API key from https://resend.com/api-keys

RESEND_API_KEY=re_your_api_key_here

# Vision XIX Labs AI chatbot — get key from https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-your_openai_key_here
CONTACT_EMAIL=support@visionxixlabs.com
RESEND_FROM_EMAIL=onboarding@resend.dev

# Auth (generate with: openssl rand -base64 32)
# NEXTAUTH_SECRET=your_secret_here
# NEXTAUTH_URL=http://localhost:3000

# Stripe Payment Links — create at https://dashboard.stripe.com/payment-links
# Per-plan (takes precedence):
# NEXT_PUBLIC_STRIPE_STARTER_MONTHLY=https://buy.stripe.com/xxx
# NEXT_PUBLIC_STRIPE_STARTER_YEARLY=https://buy.stripe.com/xxx
# NEXT_PUBLIC_STRIPE_GROWTH_MONTHLY=https://buy.stripe.com/xxx
# NEXT_PUBLIC_STRIPE_GROWTH_YEARLY=https://buy.stripe.com/xxx
# NEXT_PUBLIC_STRIPE_SCALE_MONTHLY=https://buy.stripe.com/xxx
# NEXT_PUBLIC_STRIPE_SCALE_YEARLY=https://buy.stripe.com/xxx
# Fallback: single link for all plans if per-plan not set
# NEXT_PUBLIC_STRIPE_CHECKOUT_LINK=https://buy.stripe.com/xxx

# Optional: secret to view internal pricing at /internal/pricing?key=YOUR_SECRET
# INTERNAL_PRICING_KEY=your_secret_string
