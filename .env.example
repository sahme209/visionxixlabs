# Copy to .env.local and fill in your values.

# Database (PostgreSQL required for Vercel)
# Use Vercel Postgres, Neon, Supabase, or any Postgres provider
# DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"
# Get your API key from https://resend.com/api-keys

RESEND_API_KEY=re_your_api_key_here

# AI provider — at least one required. OpenAI primary; Gemini optional fallback.
# OpenAI: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-your_openai_key_here
# Gemini: https://aistudio.google.com/apikey (fallback when OpenAI fails or rate-limited)
# GEMINI_API_KEY=your_gemini_key_here
# Model (OpenAI): gpt-4o (default for smarter) | gpt-4o-mini for cost savings
# MODEL_NAME=gpt-4o
CONTACT_EMAIL=support@visionxixlabs.com
RESEND_FROM_EMAIL=onboarding@resend.dev

# Auth (generate with: openssl rand -base64 32)
# NEXTAUTH_SECRET=your_secret_here
# NEXTAUTH_URL=http://localhost:3000

# Stripe Payment Links — create at https://dashboard.stripe.com/payment-links
# Per-plan (takes precedence):
# NEXT_PUBLIC_STRIPE_STARTER_MONTHLY=https://buy.stripe.com/xxx
# NEXT_PUBLIC_STRIPE_STARTER_YEARLY=https://buy.stripe.com/xxx
# NEXT_PUBLIC_STRIPE_GROWTH_MONTHLY=https://buy.stripe.com/xxx
# NEXT_PUBLIC_STRIPE_GROWTH_YEARLY=https://buy.stripe.com/xxx
# NEXT_PUBLIC_STRIPE_SCALE_MONTHLY=https://buy.stripe.com/xxx
# NEXT_PUBLIC_STRIPE_SCALE_YEARLY=https://buy.stripe.com/xxx
# Fallback: single link for all plans if per-plan not set
# NEXT_PUBLIC_STRIPE_CHECKOUT_LINK=https://buy.stripe.com/xxx

# Stripe Webhook — to set User.plan when customer pays
# Create webhook at https://dashboard.stripe.com/webhooks → Add endpoint → /api/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price IDs (from your Payment Links) — comma-separated per plan
# STRIPE_PRICES_STARTER=price_xxx,price_yyy
# STRIPE_PRICES_GROWTH=price_aaa,price_bbb
# STRIPE_PRICES_SCALE=price_ccc,price_ddd

# Optional: secret to view internal pricing at /internal/pricing?key=YOUR_SECRET
# INTERNAL_PRICING_KEY=your_secret_string

# AI Website Build — New Website Request flow
# Generate signed tokens for preview/thank-you links (required)
# STARTER_TOKEN_SECRET=your_hmac_secret_32_chars_min

# OpenAI for AI starter package generation
# OPENAI_API_KEY=sk-proj-your_openai_key_here
# MODEL_NAME=gpt-4o-mini

# Vercel Deployments API for preview/production deploy
# VERCEL_TOKEN=vercel_api_token
# VERCEL_TEAM_ID=team_xxx (optional, for team projects)

# Base URL for emails and links
# NEXT_PUBLIC_BASE_URL=https://visionxixlabs.com
