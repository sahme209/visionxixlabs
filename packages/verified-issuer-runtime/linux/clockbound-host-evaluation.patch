+    #[cfg(feature = "axiom-host-evaluation")]
+    pub(super) async fn run_host_evaluation_ipv4(&mut self) -> Result<(), NtpIoError> {
+        debug!("Starting Amazon Time Sync sampling loop.");
+        let mut seen_failures = [false; 8];
+        loop {
+            let branches = self.ntp.select_branches();
+            tokio::select! {
+                biased; // priority order is disruption, commands, and ticks
+                val = branches.clock_disruption_receiver.changed() => {
+                    if let Err(e) = val {
+                        error!(?e, "Clock disruption receiver dropped.");
+                        break;
+                    }
+                    if self.ntp.handle_disruption() {
+                        info!("Amazon Time Sync source transitioning from `Normal` mode to `Burst` mode.");
+                    }
+                }
+                ctrl_req = branches.ctrl_receiver.recv() => {
+                    match ctrl_req {
+                        None => {
+                            // this select can happen if `SourceIO` drops the ctrl_sender
+                            break;
+                        },
+                        Some(ControlRequest::Shutdown) => {
+                            debug!("Received shutdown signal. Exiting.");
+                            break;
+                        },
+                    }
+                }
+                _ = branches.interval.tick() => {
+                    // Source-bound ordinary IPv4 evaluation: never call the stock
+                    // routing-failure stack switch or substitute another source.
+                    assert_eq!(self.ntp.socket_address(), SocketAddr::new(IpAddr::from(ADDRESS_V4), PORT));
+                    match self.ntp.sample().await {
+                        Ok(event) => self.ntp.send_event(&event).expect("owned NTP receiver"),
+                        Err(error) => {
+                            let (index, category) = Self::host_evaluation_error(&error);
+                            // At most one fixed event per category per owned runner.
+                            // No raw errno strings, packet contents or error Display.
+                            if !seen_failures[index] {
+                                seen_failures[index] = true;
+                                println!("{{\"format\":1,\"event\":\"ntp_failure\",\"category\":\"{}\",\"strictTimeAuthority\":false}}", category);
+                            }
+                        }
+                    }
+                    self.ntp.handle_burst_expiry();
+                }
+            }
+        }
+        debug!("Amazon Time Sync runner exiting.");
+        Ok(())
+    }
+
+    #[cfg(feature = "axiom-host-evaluation")]
+    fn host_evaluation_error(error: &NtpIoError) -> (usize, &'static str) {
+        use std::io::ErrorKind;
+        use super::ntp::UnusableNtpResponse;
+        match error {
+            NtpIoError::Bind(error) | NtpIoError::SampleIo(error)
+                if error.kind() == ErrorKind::PermissionDenied => (0, "permission_refused"),
+            NtpIoError::Bind(_) => (1, "bind_failure"),
+            NtpIoError::Timeout(_) => (2, "sample_timeout"),
+            NtpIoError::SampleIo(error) if error.kind() == ErrorKind::TimedOut => (2, "sample_timeout"),
+            NtpIoError::SampleIo(error) if error.kind() == ErrorKind::InvalidData => (3, "malformed_response"),
+            NtpIoError::UnusableNtpResponse { source, .. } => match source {
+                UnusableNtpResponse::InvalidStratum(_) | UnusableNtpResponse::BadTimestamps => (3, "malformed_response"),
+                UnusableNtpResponse::Unsynchronized => (4, "source_unsynchronized"),
+                UnusableNtpResponse::KissODeath(_) => (5, "source_unavailable"),
+            },
+            NtpIoError::SampleIo(error) if matches!(error.kind(), ErrorKind::NetworkUnreachable | ErrorKind::HostUnreachable | ErrorKind::ConnectionRefused | ErrorKind::AddrNotAvailable) => (5, "source_unavailable"),
+            NtpIoError::TscOrder { .. } => (6, "counter_order_failure"),
+            NtpIoError::SampleIo(_) => (7, "sample_io_failure"),
+        }
+    }
