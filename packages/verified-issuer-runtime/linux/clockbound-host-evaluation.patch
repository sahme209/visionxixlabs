+    /// Same actual IO/algorithm/clock-state run path, with bounded source facts.
+    #[cfg(feature = "axiom-host-evaluation")]
+    pub(crate) async fn run_host_evaluation(mut self: Box<Self>) {
+        self.clock_sync_algorithm.init_repro();
+        self.io_front_end.spawn_host_evaluation_ntp_only();
+        let mut clock_state = self.clock_state_handle.clock_state.take().expect("owned clock state");
+        self.clock_state_handle.task_tracker.spawn(async move { clock_state.run().await; });
+        self.clock_state_handle.task_tracker.close();
+        let mut next_observation = tokio::time::Instant::now();
+        loop {
+            // Complete the real run_once, including cancellation cleanup. The
+            // observer never races/drops that future at a timer boundary.
+            if self.run_once().await == RunLoopControl::Exit { break; }
+            if tokio::time::Instant::now() >= next_observation {
+                let snapshot = self.sources_snapshot();
+                assert_eq!(snapshot.sources.len(), 1, "one source required");
+                let source = &snapshot.sources[0];
+                assert!(matches!(&source.source_info, SourceInfo::AmazonTimeSync(..)));
+                println!("{{\"format\":1,\"event\":\"ntp_observation\",\"requests\":{},\"responses\":{},\"strictTimeAuthority\":false,\"vmclockSupport\":false}}", source.requests, source.responses);
+                next_observation = tokio::time::Instant::now() + tokio::time::Duration::from_secs(1);
+            }
+        }
+    }
