+    // Deliberately unusable sentinel, not a measured time bound. Unknown and
+    // Disrupted records are rejected before interval arithmetic. No clock read,
+    // skew conversion or optional snapshot builder can skip this write.
+    fn invalidate(&mut self, status: ClockStatus) {
+        let ceb = ClockErrorBoundGeneric::builder()
+            .as_of(TimeSpec::new(0, 0))
+            .void_after(TimeSpec::new(0, 1))
+            .bound_nsec(0)
+            .disruption_marker(self.disruption_marker)
+            .max_drift_ppb(0)
+            .clock_status(status)
+            .clock_disruption_support_enabled(self.clock_disruption_support_enabled)
+            .build(ClockErrorBoundLayoutVersion::V2);
+        self.shm_writer.write(&ceb);
+    }
+
+    pub fn invalidate_unknown(&mut self) {
+        self.invalidate(ClockStatus::Unknown);
+    }
+
+    pub fn invalidate_disruption(&mut self, marker: u64) {
+        self.disruption_marker = marker;
+        self.invalidate(ClockStatus::Disrupted);
     }
 
