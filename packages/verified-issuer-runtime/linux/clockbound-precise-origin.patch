+/// Actual I/O origin only; never synthesized from logs or feed-time scheduling.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum OriginSourceKind { Ntp, Phc }
+#[derive(Clone, PartialEq, Eq)]
+pub struct PreciseOrigin {
+    pub(crate) kind: OriginSourceKind,
+    pub(crate) lower_ns: u64,
+    pub(crate) counter_pre: i64,
+    pub(crate) counter_post: i64,
+}
+impl std::fmt::Debug for PreciseOrigin {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result { f.write_str("PreciseOrigin(REDACTED)") }
+}
+pub(crate) struct MonotonicPrecise;
+impl MonotonicPrecise {
+    pub(crate) fn lower_ns() -> u64 {
+        let t = clock_gettime(ClockId::CLOCK_MONOTONIC).expect("precise origin clock failed");
+        let sec = u64::try_from(t.tv_sec()).expect("negative precise origin");
+        let ns = u64::try_from(t.tv_nsec()).expect("negative precise fraction");
+        let value = sec.checked_mul(1_000_000_000).and_then(|s| s.checked_add(ns))
+            .filter(|v| ns < 1_000_000_000 && *v <= i64::MAX as u64)
+            .expect("precise origin overflow");
+        value
+    }
+}
+impl PreciseOrigin {
+    pub(crate) fn bind(lower_ns: u64, counter_pre: i64, counter_post: i64, kind: OriginSourceKind) -> Self {
+        assert!(lower_ns <= i64::MAX as u64 && counter_pre >= 0 && counter_post > counter_pre);
+        Self { lower_ns, counter_pre, counter_post, kind }
+    }
+}
