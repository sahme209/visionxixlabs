+pub enum Shm0Writer {
+    Stock(Box<dyn ShmWrite + Send + Sync>),
+    Axiom(crate::daemon::time_publication_adapter::NativeTimePublisher),
+}
+impl Shm0Writer {
+    fn invalidate(&mut self, value: &ClockErrorBound) {
+        match self { Self::Stock(w) => w.write(value), Self::Axiom(w) => w.invalidate_then_delegate(value) }
+    }
+    fn publish(&mut self, value: &ClockErrorBound, parameters: &ClockParameters, configured_drift: u32, rtt_ns: i64) {
+        match self {
+            Self::Stock(w) => w.write(value),
+            Self::Axiom(w) => w.publish_precise_then_delegate(parameters.axiom_origin.as_ref(),
+                parameters.period.get(), parameters.period_max_error.get(), configured_drift, value, rtt_ns),
+        }
+    }
+}
